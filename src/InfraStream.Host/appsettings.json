{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "InfraStream": "Information"
    }
  },
  "AllowedHosts": "*",
  "InfraStream": {
    "IngressPort": 5005,
    "ManagementPort": 5002,
    "WorkerCount": 4,
    "QueueCapacity": 1024,
    "Ingress": {
      "MaxBodySize": 1048576,
      "DecompressedBufferSize": 16777216,
      "ContentDecoders": {
        "Identity": {
          "Enabled": true
        },
        "Brotli": {
          "Enabled": true,
          "Quality": 0
        },
        "Gzip": {
          "Enabled": true
        },
        "Zstd": {
          "Enabled": false,
          "Level": 0
        }
      }
    },
    "Exporters": {
      "Kafka": {
        "BootstrapServers": "kafka:9092",
        "Topic": "telemetry",
        "DeadLetterTopic": "telemetry-dead-letter",
        "InMemoryBufferSize": 1000,
        "DiskSpillPath": "./spill/",
        "MaxSpillFileSizeBytes": 104857600,
        "FlushIntervalMs": 500,
        "KafkaFlushTimeoutMs": 5000,
        "BlockTimeoutMs": 30000
      }
    }
  }
}
