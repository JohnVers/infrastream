<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>InfraStream.Host</AssemblyName>
    <RootNamespace>InfraStream.Host</RootNamespace>

    <!-- Runtime GC settings. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet: host is not packable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfraStream.CollectorEngine\InfraStream.CollectorEngine.csproj"/>
    <ProjectReference Include="..\InfraStream.Contracts\InfraStream.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore"/>
  </ItemGroup>

</Project>
